+
+.resource-toolbar {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+}
+
+.resource-search {
+  min-width: min(380px, 52vw);
+}
+
+.resource-grid {
+  display: grid;
+  gap: 18px;
+  grid-template-columns: minmax(300px, 0.95fr) minmax(0, 1.35fr);
+}
+
+.resource-form {
+  display: grid;
+  gap: 14px;
+}
+
+.resource-field {
+  display: grid;
+  gap: 8px;
+}
+
+.resource-field span {
+  font-size: 0.92rem;
+  font-weight: 700;
+}
+
+.resource-field textarea {
+  resize: vertical;
+}
+
+.resource-field.span-2,
+.resource-actions.span-2 {
+  grid-column: 1 / -1;
+}
+
+.resource-actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 10px;
+  align-items: center;
+}
+
+.resource-table-wrap {
+  overflow-x: auto;
+}
+
+.resource-table {
+  width: 100%;
+  border-collapse: collapse;
+}
+
+.resource-table th,
+.resource-table td {
+  padding: 14px 12px;
+  text-align: left;
+  border-bottom: 1px solid rgba(15, 23, 42, 0.08);
+  vertical-align: top;
+}
+
+.resource-table th {
+  font-size: 0.82rem;
+  text-transform: uppercase;
+  letter-spacing: 0.06em;
+  color: var(--muted);
+}
+
+.row-actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+}
+
+.row-action-btn,
+.primary-btn,
+.ghost-btn {
+  border-radius: 14px;
+  padding: 11px 14px;
+  font-weight: 700;
+  transition: transform 0.16s ease, background-color 0.16s ease, color 0.16s ease, border-color 0.16s ease;
+}
+
+.row-action-btn:hover,
+.primary-btn:hover,
+.ghost-btn:hover,
+.menu-button:hover,
+.notification-button:hover {
+  transform: translateY(-1px);
+}
+
+.primary-btn {
+  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-deep) 100%);
+  color: #1d1605;
+  box-shadow: 0 10px 24px rgba(255, 183, 42, 0.28);
+}
+
+.ghost-btn,
+.row-action-btn {
+  background: #fff;
+  color: var(--ink);
+  border: 1px solid var(--line);
+}
+
+.row-action-btn.danger {
+  color: var(--danger);
+  border-color: rgba(214, 69, 69, 0.24);
+}
+
+.empty-state {
+  padding: 26px;
+  color: var(--muted);
+}
+
+.dashboard-grid {
+  display: grid;
+  gap: 18px;
+}
+
+.dashboard-stats {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 14px;
+}
+
+.dashboard-stat {
+  padding: 20px;
+  border-radius: 24px;
+  background: rgba(255, 255, 255, 0.92);
+  border: 1px solid rgba(15, 23, 42, 0.08);
+  display: grid;
+  gap: 8px;
+}
+
+.dashboard-stat strong {
+  font-size: 1.7rem;
+}
+
+.dashboard-stat span {
+  color: var(--muted);
+}
+
+.dashboard-panels {
+  display: grid;
+  gap: 18px;
+  grid-template-columns: 1.1fr 0.9fr;
+}
+
+.dashboard-list {
+  display: grid;
+  gap: 12px;
+}
+
+.dashboard-list-item {
+  padding: 14px 0;
+  border-bottom: 1px solid rgba(15, 23, 42, 0.08);
+  display: grid;
+  gap: 4px;
+}
+
+.dashboard-list-item:last-child {
+  border-bottom: 0;
+}
+
+.dashboard-list-item small,
+.dashboard-list-item span,
+.muted,
+.resource-hero p,
+.dashboard-hero p {
+  color: var(--muted);
+}
+
+.dashboard-action-grid {
+  display: grid;
+  gap: 14px;
+}
+
+.dashboard-action-card {
+  text-decoration: none;
+  padding: 18px;
+  border-radius: 22px;
+  border: 1px solid rgba(15, 23, 42, 0.08);
+  background: rgba(255, 255, 255, 0.92);
+  display: grid;
+  grid-template-columns: auto 1fr auto;
+  align-items: center;
+  gap: 14px;
+}
+
+.dashboard-action-card strong,
+.dashboard-action-card small {
+  display: block;
+}
+
+.dashboard-action-card small {
+  color: var(--muted);
+  margin-top: 3px;
+}
+
+.dashboard-action-icon {
+  width: 42px;
+  height: 42px;
+  border-radius: 14px;
+  background: rgba(255, 183, 42, 0.14);
+  color: var(--brand-deep);
+  display: grid;
+  place-items: center;
+}
+
+.status-pill {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  padding: 8px 12px;
+  border-radius: 999px;
+  font-size: 0.8rem;
+  font-weight: 700;
+}
+
+.status-pill.success,
+.pill-success {
+  color: #0f6b45;
+  background: rgba(34, 160, 107, 0.12);
+}
+
+.status-pill.warning,
+.pill-warning {
+  color: #9a5b00;
+  background: rgba(217, 119, 6, 0.12);
+}
+
+.status-pill.info,
+.pill-info {
+  color: #184fa7;
+  background: rgba(47, 128, 237, 0.12);
+}
+
+.status-pill.neutral,
+.pill-neutral {
+  color: #4b5563;
+  background: rgba(75, 85, 99, 0.12);
+}
+
+.status-pill.danger,
+.pill-danger {
+  color: #9b2d2d;
+  background: rgba(214, 69, 69, 0.12);
+}
+
+@media (max-width: 1100px) {
+  .summary-grid,
+  .dashboard-stats {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+
+  .resource-grid,
+  .dashboard-panels {
+    grid-template-columns: 1fr;
+  }
+}
+
+@media (max-width: 860px) {
+  :root {
+    --app-sidebar-width: 232px;
+  }
+
+  .app-main {
+    padding: 16px;
+  }
+
+  .top-bar {
+    padding: 16px;
+  }
+
+  .resource-hero,
+  .dashboard-hero,
+  .top-bar {
+    flex-direction: column;
+    align-items: flex-start;
+  }
+
+  .resource-search {
+    min-width: 0;
+    width: 100%;
+  }
 }
